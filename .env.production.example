# Configure these in Vercel > Project > Settings > Environment Variables.
# Never commit actual values to Git or prefix private credentials with NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL=https://www.jitap.app
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_IN_VERCEL_ONLY
INTAKE_RPC_TOKEN=GENERATE_SECURE_SERVER_ONLY_64_CHARACTER_TOKEN
INTAKE_HASH_SECRET=GENERATE_A_RANDOM_64_CHARACTER_SECRET
